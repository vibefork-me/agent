        "ru": "Vibefork",
        "pt-BR": "Vibefork",
        "es-ES": "Vibefork",
        "es-419": "Vibefork",
        "de": "Vibefork"
      },
      "expect": {
        "ru": [
          "Vibefork"
        ],
        "pt-BR": [
          "Vibefork"
        ],
        "es-ES": [
          "Vibefork"
