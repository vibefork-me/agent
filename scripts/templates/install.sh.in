#!/bin/sh
# Installs a release-pinned Vibefork agent for the current user (no administrator rights).
# This file is rendered with the SHA-256 values of release binaries before it is published.
#
#   curl -fsSL https://vibefork.me/install.sh | sh
#
# VF_UPDATE_URL may point to a mirror, but only binaries matching these embedded hashes are run.
# VF_NO_OPEN=1 disables opening the browser.
set -eu

CHANNEL="${VF_UPDATE_URL:-@@CHANNEL@@}"
VERSION='@@VERSION@@'

case "$(uname -s)" in
  Linux) os=linux ;;
  Darwin) os=macos ;;
  *) echo "vibefork: unsupported system $(uname -s)" >&2; exit 1 ;;
esac
case "$(uname -m)" in
  x86_64 | amd64) arch=x86_64 ;;
  arm64 | aarch64) arch=aarch64 ;;
  *) echo "vibefork: unsupported processor $(uname -m)" >&2; exit 1 ;;
esac

case "$os-$arch" in
@@UNIX_HASH_CASES@@
  *) echo "vibefork: no pinned build for $os-$arch in release $VERSION" >&2; exit 1 ;;
esac
[ -n "$agent_hash" ] || { echo "vibefork: no pinned build for $os-$arch in release $VERSION" >&2; exit 1; }

if command -v sha256sum >/dev/null 2>&1; then sha() { sha256sum "$1" | cut -d' ' -f1; }
else sha() { shasum -a 256 "$1" | cut -d' ' -f1; }; fi

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
fetch_pinned() {
  asset="$1"
  expected="$2"
  output="$3"
  [ -n "$expected" ] || return 0
  curl -fsSL "$CHANNEL/$asset" -o "$tmp/$output"
  [ "$(sha "$tmp/$output")" = "$expected" ] || { echo "vibefork: $asset does not match the hash pinned in this installer" >&2; exit 1; }
  chmod +x "$tmp/$output"
}

fetch_pinned "vibefork-$os-$arch" "$agent_hash" vibefork
fetch_pinned "vibefork-tray-$os-$arch" "$tray_hash" vibefork-tray
"$tmp/vibefork" install
if [ "$os" = macos ]; then dir="${VF_INSTALL_DIR:-$HOME/Applications/Vibefork.app/Contents/MacOS}"
else dir="${VF_INSTALL_DIR:-$HOME/.local/bin}"; fi
"$dir/vibefork" start
[ -n "${VF_NO_OPEN:-}" ] || "$dir/vibefork" open || true
echo "Vibefork $VERSION is installed: $dir/vibefork (try \`vibefork doctor\`)"
